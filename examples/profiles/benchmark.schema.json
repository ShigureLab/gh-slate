{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
      "summary": {
         "type": "string",
         "minLength": 1
      },
      "source": {
         "type": "object",
         "properties": {
            "base_sha": {
               "type": "string",
               "minLength": 1
            },
            "head_sha": {
               "type": "string",
               "minLength": 1
            }
         },
         "required": [
            "base_sha",
            "head_sha"
         ],
         "additionalProperties": false
      },
      "environment": {
         "type": "string",
         "minLength": 1
      },
      "metrics": {
         "type": "object",
         "minProperties": 1,
         "additionalProperties": {
            "type": "object",
            "properties": {
               "before": {
                  "type": "number"
               },
               "after": {
                  "type": "number"
               },
               "change": {
                  "type": "string",
                  "minLength": 1
               },
               "unit": {
                  "type": "string",
                  "minLength": 1
               }
            },
            "required": [
               "before",
               "after",
               "change",
               "unit"
            ],
            "additionalProperties": false
         }
      },
      "notes": {
         "type": "array",
         "items": {
            "type": "string",
            "minLength": 1
         }
      }
   },
   "required": [
      "summary",
      "source",
      "environment",
      "metrics"
   ],
   "additionalProperties": false
}
